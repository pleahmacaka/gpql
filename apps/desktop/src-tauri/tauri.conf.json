{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "gpql",
  "identifier": "dev.gpql.dev",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "bun run vite",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "gpql",
        "width": 1180,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
