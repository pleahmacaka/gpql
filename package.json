{
  "name": "gpql",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter web dev",
    "dev:app": "bun run --filter desktop dev",
    "build": "bun run --filter desktop tauri build",
    "build:web": "bun run --filter web build",
    "test": "bun run --filter desktop test",
    "db:push": "bun run --filter web db:push",
    "format": "bunx biome check --write .",
    "check": "bun run --filter '*' check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "svelte2tsx": "^0.7.61"
  }
}
